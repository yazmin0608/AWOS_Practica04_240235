<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Perfil - <%= user.displayName %></title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
    <div class="container mx-auto max-w-lg bg-white p-8 rounded-2xl shadow-xl text-center">
        <h1 class="text-3xl font-bold mb-2 text-gray-800">Perfil de Usuario</h1>
        <p class="text-gray-500 mb-6 font-medium uppercase tracking-widest text-xs">
            Autenticado con <%= user.provider %>
        </p>
        
        <hr class="mb-8 border-gray-200">

        <div class="flex justify-center mb-6">
            <% if (user.photos && user.photos[0]) { %>
                <img src="<%= user.photos[0].value %>" alt="Foto de <%= user.displayName %>" 
                     class="w-32 h-32 rounded-full border-4 border-blue-500 shadow-md object-cover">
            <% } else { %>
                <div class="w-32 h-32 rounded-full bg-blue-100 flex items-center justify-center border-4 border-blue-500">
                    <span class="text-4xl">👤</span>
                </div>
            <% } %>
        </div>

        <div class="text-left bg-gray-50 p-4 rounded-xl mb-8">
            <p class="text-sm text-gray-400">Nombre:</p>
            <p class="text-lg font-semibold text-gray-700 mb-3"><%= user.displayName %></p>
            
            <p class="text-sm text-gray-400">ID de Red Social:</p>
            <p class="text-sm font-mono text-gray-600 bg-gray-200 px-2 py-1 rounded inline-block">
                <%= user.id %>
            </p>
        </div>

        <a href="/logout" class="block w-full bg-red-500 text-white font-bold py-3 rounded-xl hover:bg-red-600 transition-colors shadow-lg shadow-red-200">
            Cerrar Sesión
        </a>
    </div>
</body>
</html>